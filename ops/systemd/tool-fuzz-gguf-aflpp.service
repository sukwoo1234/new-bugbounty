[Unit]
Description=GGUF AFL++ fuzzing (퍼징컴, Arm C)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
# 퍼징컴 운영 계정으로 조정 필요 (dev 머신과 동일하면 그대로).
# 이 계정은 반드시 `docker` 그룹 소속이어야 함 (afl-out root 소유 방지 + docker.sock 접근).
User=ssw
Group=ssw
WorkingDirectory=/home/ssw/bugbounty

# ONNX 유닛과 달리 GGUF는 파서(ggml)가 replay 바이너리에 정적 링크된다. 따라서 계측 범위가
# driver_only가 아니라 library다 — wrapper가 aflpp_instrumentation_scope=library로 로그한다.
# 그 바이너리는 scripts/build_aflpp_gguf_native.sh가 만든다(도커 aflplusplus 안에서 실행).
#
# AFLPP_CONTAINER_TOOL을 여기서 설정하지 말 것 — wrapper는 이 변수가 설정돼 있으면 운영자의
# 의도적 override로 보고 계측 replay로 교체하지 않는다(AFLPP_CONTAINER_TOOL_WAS_SET).
# 기본값과 같은 값을 넣어도 arm이 blackbox_n에 영구히 고정된다. ONNX 유닛의 같은 결함이 1e8261f다.
ExecStart=/home/ssw/bugbounty/ops/scripts/fuzz-loop-aflpp.sh

# 시작 전 1회: tool 바이너리 + docker + aflplusplus 이미지 + 계측 replay 존재 확인.
ExecStartPre=/usr/bin/test -x /home/ssw/bugbounty/target/release/tool
ExecStartPre=/usr/bin/test -x /home/ssw/bugbounty/harnesses/aflpp/gguf_loader_replay
# TOOL_REQUIRE_LIBRARY_CONNECT=1 below applies to `tool triage` too, and the gguf probe
# uses the LIBFUZZER replay (GGUF_NATIVE_DEFAULT_BIN = harnesses/libfuzzer/gguf_loader_replay),
# not the AFL++ one. Without this line the arm fuzzes happily and then fails to triage
# every crash it finds.
ExecStartPre=/usr/bin/test -x /home/ssw/bugbounty/harnesses/libfuzzer/gguf_loader_replay
# seeds/ is gitignored: an empty corpus makes afl-fuzz refuse every iteration while the
# unit still reports active(running), i.e. a campaign that quietly does nothing.
ExecStartPre=/bin/sh -c 'test -n "$(ls -A /home/ssw/bugbounty/seeds/gguf 2>/dev/null)"'
ExecStartPre=/usr/bin/docker run --rm aflplusplus/aflplusplus bash -lc 'command -v afl-fuzz >/dev/null'

Environment=TARGET=gguf
# CORPUS_DIR은 두지 않는다: wrapper의 기본값이 ${PROJECT_ROOT}/seeds/${TARGET}이고,
# 절대경로를 박으면 배포 경로가 다른 호스트에서 조용히 빈 코퍼스를 가리킨다.
# 네이티브 하네스가 없으면 조용히 발견 0건으로 도는 것을 막는다.
Environment=TOOL_REQUIRE_LIBRARY_CONNECT=1
# 계측 없이 도는 것을 허용하지 않는다: 이 유닛의 존재 이유가 coverage-guided 실행이다.
Environment=REQUIRE_INSTRUMENTED=1
Environment=WORKERS=1
Environment=AFLPP_MAX_RUN_DIRS_KEEP=20

# BLAS thread pool 폭주 방지.
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1

# wrapper는 SIGTERM 외엔 거의 종료 안 함. 비정상 exit(crash/oom)만 재시작.
Restart=on-failure
RestartSec=10

LimitNOFILE=8192
# ggml 파서의 선행 할당 DoS(V4) 때문에 코어 파일과 메모리를 묶어 둔다.
LimitCORE=0
TimeoutStopSec=120
KillMode=mixed

[Install]
WantedBy=multi-user.target
