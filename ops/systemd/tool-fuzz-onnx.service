[Unit]
Description=ONNX local-harness fuzzing (퍼징컴 1-week template)
After=network.target

[Service]
Type=simple
# 퍼징컴 운영 계정으로 조정 필요 (dev 머신과 동일하면 그대로).
User=ssw
Group=ssw
WorkingDirectory=/home/ssw/bugbounty

# Continuous fuzzing via wrapper (mutate batch -> run -> sleep -> repeat).
# 기본 매개변수 (wrapper 안에 정의, systemctl edit으로 ENV override):
# - WORKERS=12 (Day 1 RAM > 85% 또는 swap > 0 시 8로 낮춤)
# - BACKEND=local-harness (engine baseline은 dev 머신에서 별도 실행)
# - TIMEOUT_SEC=30, RESTART_LIMIT=1, MUTATE_COUNT=50, ITERATION_SLEEP_SEC=2
# - MAX_BATCHES_KEEP=2000 (1주차 후반 ~25% cleanup, 2주차 본격 회전)
# - SEED_DIR=seeds/onnx (mutated batch는 wrapper가 매 iter 생성)
ExecStart=/home/ssw/bugbounty/ops/scripts/fuzz-loop.sh

# V1.5: library_connect probe Unavailable 즉시 Err로 시작 단계 환경 결함 검출.
Environment=TOOL_REQUIRE_LIBRARY_CONNECT=1

# BLAS thread pool 폭주 방지 (workers x BLAS threads 곱셈으로 CPU 과점유 차단).
# run.rs::execute_harness_subprocess가 subprocess env에도 동일 설정.
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1

# library_connect probe (python onnxruntime/safetensors) stdout buffering 방지.
Environment=PYTHONUNBUFFERED=1

# wrapper는 SIGTERM 외엔 거의 종료 안 함. 비정상 exit(crash/oom)만 재시작.
Restart=on-failure
RestartSec=10

LimitNOFILE=8192
# wrapper graceful stop: SIGTERM 받으면 현재 run 완료 후 종료.
# workers 12 × TIMEOUT_SEC 30s + cleanup 여유 = 90s 마진.
TimeoutStopSec=90
KillMode=mixed

[Install]
WantedBy=multi-user.target
