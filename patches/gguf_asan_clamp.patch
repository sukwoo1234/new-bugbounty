BUILD-TIME FUZZING PATCH -- not for upstream, never committed into a target tree.

Applied by scripts/build_libfuzzer_gguf_native.sh to the extracted copy of the
pinned llama.cpp source before it is compiled.

Why: under ASan a throwing operator new cannot honour allocator_may_return_null,
so the length_error/bad_alloc that gguf.cpp deliberately catches is turned into
an allocation-size-too-big abort before the catch runs. Unpatched, a libFuzzer
session dies after 3 execs on a 64-bit length field, and every such abort is a
harness artifact rather than a target bug. The clamp rejects a length that
cannot fit in the bytes remaining in the file, which is a parse failure the
parser would have reached anyway.

The clamp is disabled for non-seekable inputs, where the remaining size is
unknown; behaviour there is identical to the unpatched reader.

diff --git a/ggml/src/gguf.cpp b/ggml/src/gguf.cpp
index ed0d7f2..058d821 100644
--- a/ggml/src/gguf.cpp
+++ b/ggml/src/gguf.cpp
@@ -219,7 +219,42 @@ struct gguf_context {
 struct gguf_reader {
     FILE * file;
 
-    gguf_reader(FILE * file) : file(file) {}
+    // BUILD-TIME FUZZING PATCH (not for upstream): cache the total size of the
+    // (seekable) input so length fields read from the file can be clamped to the
+    // bytes that actually remain, before any std::vector/std::string allocation.
+    // This turns a doomed huge allocation into a clean parse failure instead of an
+    // ASan allocation-size-too-big abort. long_size < 0 means "size unknown" and
+    // disables the clamp (behaviour identical to the unpatched reader).
+    long file_size;
+
+    static long fuzz_file_size(FILE * f) {
+        if (f == nullptr) {
+            return -1;
+        }
+        const long cur = ftell(f);
+        if (cur < 0 || fseek(f, 0, SEEK_END) != 0) {
+            return -1;
+        }
+        const long end = ftell(f);
+        if (fseek(f, cur, SEEK_SET) != 0) {
+            return -1;
+        }
+        return end;
+    }
+
+    // Bytes from the current file position to EOF; UINT64_MAX when size is unknown.
+    uint64_t fuzz_remaining() const {
+        if (file_size < 0) {
+            return UINT64_MAX;
+        }
+        const long pos = ftell(file);
+        if (pos < 0 || pos > file_size) {
+            return 0;
+        }
+        return (uint64_t) (file_size - pos);
+    }
+
+    gguf_reader(FILE * file) : file(file), file_size(fuzz_file_size(file)) {}
 
     template <typename T>
     bool read(T & dst) const {
@@ -228,6 +263,15 @@ struct gguf_reader {
 
     template <typename T>
     bool read(std::vector<T> & dst, const size_t n) const {
+        // BUILD-TIME FUZZING PATCH: an array cannot contain more elements than the
+        // file has bytes left to hold them. Each element occupies at least its
+        // on-disk minimum: sizeof(T) for fixed-width scalars, or the 8-byte length
+        // prefix for a string element (its content is checked in read(std::string&)).
+        constexpr size_t fuzz_elem_min =
+            std::is_same<T, std::string>::value ? sizeof(uint64_t) : sizeof(T);
+        if (fuzz_elem_min != 0 && n > fuzz_remaining() / fuzz_elem_min) {
+            return false;
+        }
         dst.resize(n);
         for (size_t i = 0; i < dst.size(); ++i) {
             if constexpr (std::is_same<T, bool>::value) {
@@ -277,6 +321,11 @@ struct gguf_reader {
         if (!read(size)) {
             return false;
         }
+        // BUILD-TIME FUZZING PATCH: a string of `size` bytes must have `size` bytes
+        // remaining in the file; reject before the allocation instead of aborting.
+        if (size > fuzz_remaining()) {
+            return false;
+        }
         dst.resize(size);
         return fread(dst.data(), 1, dst.length(), file) == dst.length();
     }
